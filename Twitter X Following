// ==UserScript==
// @name         Twitter X Following 关注列表抓取
// @namespace    http://tampermonkey.net/
// @version      2.1
// @description  自动滚动抓取UserCell，本地缓存断点续抓；一键保存导出全部数据（CSV+JSON，含用户主页链接 name_url）；CSV 输出 UTF-8 BOM 防 Excel 乱码；导出前自动修复断行 URL
// @author       You
// @match        https://x.com/*/following
// @grant        none
// @license MIT
// ==/UserScript==
/*
免责声明：
本脚本仅限个人学习研究，使用风险由使用者自行承担。
因使用本脚本造成的账号处罚、数据丢失等一切后果，作者概不负责。
使用即代表同意本声明，请遵守相关法规与网站协议。
*/

(function() {
    'use strict';

    const STORAGE_KEY = "x_following_capture_data";

    // ========== 工具函数 ==========
    const sleep = (ms) => new Promise(resolve => setTimeout(resolve, ms));

    // 修复被换行拆散的 URL（X 页面 innerText 常见 "https://\n域名" 格式）
    function fixBrokenUrl(text) {
        return String(text || '').replace(/(https?:\/\/)\s*\n\s*/gi, '$1');
    }

    // 下载 Blob：元素挂入 DOM 触发点击，稍后回收 URL
    function downloadBlob(blob, fileName) {
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = fileName;
        document.body.appendChild(a);
        a.click();
        a.remove();
        setTimeout(() => URL.revokeObjectURL(url), 1000);
    }

    // ========== 状态 ==========
    let isRunning = false;
    let seenHandles = new Set();
    let resultList = [];
    let scrollTimer = null;
    // 记录本次会话新增的用户
    let sessionNewList = [];

    // ========== 控制面板 ==========
    function makeButton(text, bg) {
        const btn = document.createElement('button');
        btn.innerText = text;
        Object.assign(btn.style, {
            width: '100%',
            padding: '5px',
            marginBottom: '5px',
            background: bg,
            color: '#fff',
            border: 'none',
            borderRadius: '4px',
            cursor: 'pointer',
            fontSize: '12px'
        });
        return btn;
    }

    const panel = document.createElement('div');
    Object.assign(panel.style, {
        position: 'fixed',
        top: '60px',
        right: '12px',
        zIndex: '9999',
        padding: '8px',
        background: '#222',
        borderRadius: '8px',
        color: '#fff',
        width: '160px',
        fontSize: '12px',
        boxShadow: '0 2px 8px #0006'
    });

    const statusText = document.createElement('div');
    statusText.style.marginBottom = '8px';
    statusText.style.lineHeight = '1.3';

    const startBtn = makeButton('开始抓取', '#1d9bf0');
    const stopBtn = makeButton('停止抓取', '#f4212e');
    const saveBtn = makeButton('保存导出', '#30a14e');
    const clearCacheBtn = makeButton('清空缓存', '#ff6600');

    panel.appendChild(statusText);
    [startBtn, stopBtn, saveBtn, clearCacheBtn].forEach(b => panel.appendChild(b));
    document.body.appendChild(panel);

    function updateStatus() {
        statusText.innerText = `总${resultList.length}｜本次${sessionNewList.length}`;
    }

    // ========== 本地存储读写 ==========
    function loadFromLocalStorage() {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return;
        try {
            const parsed = JSON.parse(raw);
            resultList = parsed.list || [];
            seenHandles = new Set(parsed.seen || []);
            console.log(`📥 从本地缓存加载：${resultList.length}条记录`);
        } catch (e) {
            console.error("读取本地缓存失败，重置缓存", e);
            clearLocalStorage();
        }
    }

    function saveToLocalStorage() {
        const storeData = {
            list: resultList,
            seen: Array.from(seenHandles)
        };
        localStorage.setItem(STORAGE_KEY, JSON.stringify(storeData));
        console.log(`💾 保存到本地缓存，共${resultList.length}条`);
    }

    function clearLocalStorage() {
        localStorage.removeItem(STORAGE_KEY);
        resultList = [];
        seenHandles = new Set();
        sessionNewList = [];
        console.log("🗑️ 本地缓存已清空");
        updateStatus();
    }

    // 面板构建完成后读取缓存（clearLocalStorage 依赖 statusText）
    loadFromLocalStorage();
    updateStatus();

    // ========== 核心：提取UserCell卡片数据 ==========
    function collectVisibleUsers() {
        const cards = document.querySelectorAll('button[data-testid="UserCell"]');
        let newCount = 0;

        cards.forEach(card => {
            // 账号链接 /TeikokuKizoku
            const handleLink = card.querySelector('a[href^="/"]');
            if (!handleLink) return;
            const href = handleLink.getAttribute('href').trim();
            const rawHandle = href.replace('/', '');
            if (!rawHandle || rawHandle.includes('/status/')) return;
            // 只接受合法账号名（字母/数字/下划线，15 位以内），排除设置/搜索等非用户链接
            if (!/^[A-Za-z0-9_]{1,15}$/.test(rawHandle)) return;
            if (seenHandles.has(rawHandle)) return;

            seenHandles.add(rawHandle);
            newCount++;

            // 账户显示姓名
            const nameEl = card.querySelector('a[href^="/"] > div > div > span > span');
            const name = nameEl?.innerText?.trim() || '';

            // @账号
            let handleText = '';
            const allSpans = card.querySelectorAll('span.css-1jxf684');
            for (const span of allSpans) {
                const txt = span.innerText.trim();
                if (txt.startsWith('@')) {
                    handleText = txt;
                    break;
                }
            }

            // 简介内容（采集时即修复断行 URL，缓存与导出数据均干净）
            const bioEl = card.querySelector('div[dir="auto"].css-146c3p1.r-bcqeeo');
            const bio = fixBrokenUrl(bioEl?.innerText?.trim() || '');

            // 收集简介内第一个网址
            let website = '';
            const linkList = bioEl?.querySelectorAll('a[href^="https://t.co/"], a[href^="http"]') || [];
            if (linkList.length > 0) {
                website = linkList[0].href;
            }

            const userItem = {
                name,
                handle: handleText,
                // 用户名主页链接（如 https://x.com/zynxy）
                name_url: 'https://x.com/' + rawHandle,
                bio,
                website
            };
            resultList.push(userItem);
            sessionNewList.push(userItem);
        });

        // 采集一轮就保存到本地缓存
        if (newCount > 0) {
            saveToLocalStorage();
        }
        updateStatus();
        console.log(`本次新增 ${newCount}，总数量: ${resultList.length}`);
    }

    // ========== 自动滚动循环 ==========
    async function autoScrollCollect() {
        if (!isRunning) return;
        const lastScrollHeight = document.documentElement.scrollHeight;
        window.scrollTo(0, document.documentElement.scrollHeight);
        await sleep(3000); // 等待加载，网络差改为3500
        if (!isRunning) return; // 等待期间被停止则不再采集
        collectVisibleUsers();
        const newScrollHeight = document.documentElement.scrollHeight;

        if (newScrollHeight === lastScrollHeight) {
            isRunning = false;
            statusText.innerText = `✅完成｜总${resultList.length}｜本次${sessionNewList.length}`;
            return;
        }
        scrollTimer = setTimeout(autoScrollCollect, 500);
    }

    // ========== 导出工具函数 ==========
    // 导出前统一清洗：补全 name_url（兼容旧缓存数据）、修复断行 URL、补齐空字段
    function buildExportRows(dataArray) {
        return dataArray.map(item => ({
            name: item.name || '',
            handle: item.handle || '',
            name_url: item.name_url || (item.handle ? 'https://x.com/' + String(item.handle).replace(/^@/, '') : ''),
            bio: fixBrokenUrl(item.bio),
            website: item.website || ''
        }));
    }

    function exportCSV(dataArray, fileNamePrefix) {
        if (!dataArray || dataArray.length === 0) {
            alert("暂无数据！");
            return;
        }
        const rows = buildExportRows(dataArray);
        const header = "账户姓名,账号,个人主页,介绍,个人网址\n";
        const escape = (s) => `"${String(s ?? '').replace(/"/g, '""')}"`;
        const body = rows.map(item =>
            [item.name, item.handle, item.name_url, item.bio, item.website].map(escape).join(',')
        ).join('\n');
        // 加 UTF-8 BOM：Excel 直接打开中文不乱码
        const blob = new Blob(['\uFEFF' + header + body], { type: 'text/csv;charset=utf-8' });
        downloadBlob(blob, `${fileNamePrefix}-${new Date().toISOString().slice(0, 10)}.csv`);
    }

    function exportJSON(dataArray, fileNamePrefix) {
        if (!dataArray || dataArray.length === 0) {
            alert("暂无数据！");
            return;
        }
        const rows = buildExportRows(dataArray);
        const blob = new Blob([JSON.stringify(rows, null, 2)], { type: 'application/json;charset=utf-8' });
        downloadBlob(blob, `${fileNamePrefix}-${new Date().toISOString().slice(0, 10)}.json`);
    }

    // ========== 按钮事件 ==========
    startBtn.onclick = () => {
        if (isRunning) return;
        isRunning = true;
        statusText.innerText = "🔄采集中...";
        autoScrollCollect();
    };

    stopBtn.onclick = () => {
        isRunning = false;
        if (scrollTimer) {
            clearTimeout(scrollTimer);
            scrollTimer = null;
        }
        updateStatus();
    };

    // 一键保存导出：全部数据同时输出 CSV 与 JSON（含个人主页链接）
    saveBtn.onclick = () => {
        if (!resultList.length) {
            alert("暂无数据！");
            return;
        }
        exportCSV(resultList, "x-following-all");
        exportJSON(resultList, "x-following-all");
    };

    clearCacheBtn.onclick = () => {
        if (confirm("确认清空本地全部缓存记录？此操作不可恢复！")) {
            clearLocalStorage();
        }
    };

})();
