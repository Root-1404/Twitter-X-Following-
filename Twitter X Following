// ==UserScript==
// @name         Twitter X Following 关注列表抓取
// @namespace    http://tampermonkey.net/
// @version      1.0
// @description  自动滚动抓取UserCell，本地缓存断点续抓，刷新页面不丢失；支持导出全部 / 仅本次会话新增数据
// @author       You
// @match        https://x.com/*/following
// @grant        none
// ==/UserScript==
/*
免责声明：
本脚本仅限个人学习研究，使用风险由使用者自行承担。
因使用本脚本造成的账号处罚、数据丢失等一切后果，作者概不负责。
使用即代表同意本声明，请遵守相关法规与网站协议。
*/

(function() {
    'use strict';

    const STORAGE_KEY = "x_following_capture_data";
    let isRunning = false;
    let seenHandles = new Set();
    let resultList = [];
    let scrollTimer = null;
    // 记录本次会话新增的用户
    let sessionNewList = [];

    // ========== 本地存储读写 ==========
    function loadFromLocalStorage(){
        const raw = localStorage.getItem(STORAGE_KEY);
        if(!raw) return;
        try{
            const parsed = JSON.parse(raw);
            resultList = parsed.list || [];
            seenHandles = new Set(parsed.seen || []);
            console.log(`📥 从本地缓存加载：${resultList.length}条记录`);
        }catch(e){
            console.error("读取本地缓存失败，重置缓存", e);
            clearLocalStorage();
        }
    }
    function saveToLocalStorage(){
        const storeData = {
            list: resultList,
            seen: Array.from(seenHandles)
        };
        localStorage.setItem(STORAGE_KEY, JSON.stringify(storeData));
        console.log(`💾 保存到本地缓存，共${resultList.length}条`);
    }
    function clearLocalStorage(){
        localStorage.removeItem(STORAGE_KEY);
        resultList = [];
        seenHandles = new Set();
        sessionNewList = [];
        console.log("🗑️ 本地缓存已清空");
        statusText.innerText = "✅缓存清空｜0条";
    }

    // 页面加载时自动读取缓存
    loadFromLocalStorage();

    // ========== 控制面板【紧凑小巧样式】 ==========
    const panel = document.createElement('div');
    Object.assign(panel.style, {
        position: 'fixed',
        top: '60px',
        right: '12px',
        zIndex: '9999',
        padding: '8px',
        background: '#222',
        borderRadius: '8px',
        color: '#fff',
        width: '160px',
        fontSize: '12px',
        boxShadow: '0 2px 8px #0006'
    });

    const startBtn = document.createElement('button');
    startBtn.innerText = '开始抓取';
    Object.assign(startBtn.style, {
        width: '100%',
        padding: '5px',
        marginBottom: '5px',
        background: '#1d9bf0',
        color: '#fff',
        border: 'none',
        borderRadius: '4px',
        cursor: 'pointer',
        fontSize: '12px'
    });

    const stopBtn = document.createElement('button');
    stopBtn.innerText = '停止抓取';
    Object.assign(stopBtn.style, {
        width: '100%',
        padding: '5px',
        marginBottom: '5px',
        background: '#f4212e',
        color: '#fff',
        border: 'none',
        borderRadius: '4px',
        cursor: 'pointer',
        fontSize: '12px'
    });

    const exportAllCsvBtn = document.createElement('button');
    exportAllCsvBtn.innerText = '全部CSV';
    Object.assign(exportAllCsvBtn.style, {
        width: '100%',
        padding: '5px',
        marginBottom: '5px',
        background: '#30a14e',
        color: '#fff',
        border: 'none',
        borderRadius: '4px',
        cursor: 'pointer',
        fontSize: '12px'
    });

    const exportNewCsvBtn = document.createElement('button');
    exportNewCsvBtn.innerText = '新增CSV';
    Object.assign(exportNewCsvBtn.style, {
        width: '100%',
        padding: '5px',
        marginBottom: '5px',
        background: '#009688',
        color: '#fff',
        border: 'none',
        borderRadius: '4px',
        cursor: 'pointer',
        fontSize: '12px'
    });

    const exportAllJsonBtn = document.createElement('button');
    exportAllJsonBtn.innerText = '全部JSON';
    Object.assign(exportAllJsonBtn.style, {
        width: '100%',
        padding: '5px',
        marginBottom: '5px',
        background: '#888',
        color: '#fff',
        border: 'none',
        borderRadius: '4px',
        cursor: 'pointer',
        fontSize: '12px'
    });

    const exportNewJsonBtn = document.createElement('button');
    exportNewJsonBtn.innerText = '新增JSON';
    Object.assign(exportNewJsonBtn.style, {
        width: '100%',
        padding: '5px',
        marginBottom: '5px',
        background: '#7b1fa2',
        color: '#fff',
        border: 'none',
        borderRadius: '4px',
        cursor: 'pointer',
        fontSize: '12px'
    });

    const clearCacheBtn = document.createElement('button');
    clearCacheBtn.innerText = '清空缓存';
    Object.assign(clearCacheBtn.style, {
        width: '100%',
        padding: '5px',
        marginBottom: '5px',
        background: '#ff6600',
        color: '#fff',
        border: 'none',
        borderRadius: '4px',
        cursor: 'pointer',
        fontSize: '12px'
    });

    const statusText = document.createElement('div');
    statusText.style.marginBottom = '8px';
    statusText.style.lineHeight = '1.3';
    statusText.innerText = `已缓存${resultList.length}｜本次新增0`;

    panel.appendChild(statusText);
    panel.appendChild(startBtn);
    panel.appendChild(stopBtn);
    panel.appendChild(exportAllCsvBtn);
    panel.appendChild(exportNewCsvBtn);
    panel.appendChild(exportAllJsonBtn);
    panel.appendChild(exportNewJsonBtn);
    panel.appendChild(clearCacheBtn);
    document.body.appendChild(panel);


    // ========== 核心：提取UserCell卡片数据 ==========
    function collectVisibleUsers() {
        const cards = document.querySelectorAll('button[data-testid="UserCell"]');
        let newCount = 0;

        cards.forEach(card => {
            // 账号链接 /TeikokuKizoku
            const handleLink = card.querySelector('a[href^="/"]');
            if (!handleLink) return;
            const href = handleLink.getAttribute('href').trim();
            const rawHandle = href.replace('/', '');
            if (!rawHandle || rawHandle.includes('/status/')) return;
            if (seenHandles.has(rawHandle)) return;

            seenHandles.add(rawHandle);
            newCount++;

            // 账户显示姓名
            const nameEl = card.querySelector('a[href^="/"] > div > div > span > span');
            const name = nameEl?.innerText?.trim() || '';

            // @账号
            let handleText = '';
            const allSpans = card.querySelectorAll('span.css-1jxf684');
            for(const span of allSpans){
                const txt = span.innerText.trim();
                if(txt.startsWith('@')){
                    handleText = txt;
                    break;
                }
            }

            // 简介内容
            const bioEl = card.querySelector('div[dir="auto"].css-146c3p1.r-bcqeeo');
            const bio = bioEl?.innerText?.trim() || '';

            // 收集简介内第一个网址
            let website = '';
            const linkList = bioEl?.querySelectorAll('a[href^="https://t.co/"], a[href^="http"]') || [];
            if(linkList.length > 0){
                website = linkList[0].href;
            }

            const userItem = {
                name,
                handle: handleText,
                bio,
                website
            };
            resultList.push(userItem);
            sessionNewList.push(userItem);
        });

        // 采集一轮就保存到本地缓存
        if(newCount > 0){
            saveToLocalStorage();
        }
        statusText.innerText = `总${resultList.length}｜本次${sessionNewList.length}`;
        console.log(`本次新增 ${newCount}，总数量: ${resultList.length}`);
    }


    // ========== 自动滚动循环 ==========
    async function autoScrollCollect() {
        if (!isRunning) return;
        const lastScrollHeight = document.documentElement.scrollHeight;
        window.scrollTo(0, document.documentElement.scrollHeight);
        await sleep(3000); // 等待加载，网络差改为3500
        collectVisibleUsers();
        const newScrollHeight = document.documentElement.scrollHeight;

        if (newScrollHeight === lastScrollHeight) {
            statusText.innerText = `✅完成｜总${resultList.length}｜本次${sessionNewList.length}`;
            isRunning = false;
            return;
        }
        scrollTimer = setTimeout(autoScrollCollect, 500);
    }

    function sleep(ms) {
        return new Promise(resolve => setTimeout(resolve, ms));
    }

    // ========== 导出工具函数 ==========
    function exportCSV(dataArray, fileNamePrefix){
        if (!dataArray || dataArray.length === 0) {
            alert("暂无数据！");
            return;
        }
        const header = "账户姓名,账号,介绍,个人网址\n";
        const escape = (s) => `"${(s || "").replace(/"/g, '""')}"`;
        const rows = dataArray.map(item => {
            return `${escape(item.name)},${escape(item.handle)},${escape(item.bio)},${escape(item.website)}`;
        }).join('\n');
        const blob = new Blob([header + rows], { type: 'text/csv;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `${fileNamePrefix}-${new Date().toISOString().slice(0,10)}.csv`;
        a.click();
        URL.revokeObjectURL(url);
    }
    function exportJSON(dataArray, fileNamePrefix){
        if (!dataArray || dataArray.length === 0) {
            alert("暂无数据！");
            return;
        }
        const blob = new Blob([JSON.stringify(dataArray, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `${fileNamePrefix}-${new Date().toISOString().slice(0,10)}.json`;
        a.click();
        URL.revokeObjectURL(url);
    }

    // ========== 按钮事件 ==========
    startBtn.onclick = () => {
        if(isRunning) return;
        isRunning = true;
        statusText.innerText = "🔄采集中...";
        autoScrollCollect();
    };

    stopBtn.onclick = () => {
        isRunning = false;
        if (scrollTimer) clearTimeout(scrollTimer);
        statusText.innerText = `⏹️已停止｜总${resultList.length}｜本次${sessionNewList.length}`;
    };

    // 全部导出
    exportAllCsvBtn.onclick = () => exportCSV(resultList, "x-following-all");
    exportAllJsonBtn.onclick = () => exportJSON(resultList, "x-following-all");
    // 仅本次会话新增
    exportNewCsvBtn.onclick = () => exportCSV(sessionNewList, "x-following-session-new");
    exportNewJsonBtn.onclick = () => exportJSON(sessionNewList, "x-following-session-new");

    clearCacheBtn.onclick = () => {
        if(confirm("确认清空本地全部缓存记录？此操作不可恢复！")){
            clearLocalStorage();
        }
    };

})();
